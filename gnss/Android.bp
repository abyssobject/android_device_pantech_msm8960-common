// GNSS HAL service for the legacy gps.msm8960 blobs.

// Provides set_sched_policy to libloc_eng.so/libloc_core.so. Linked with
// -z global so that, as a DT_NEEDED of the service executable, it is in the
// global lookup group when gps.msm8960.so is dlopen()ed.
cc_library_shared {
    name: "libsched_policy_shim_msm8960",
    vendor: true,
    compile_multilib: "32",
    srcs: ["sched_policy_shim.cpp"],
    shared_libs: [
        "liblog",
        "libprocessgroup",
    ],
    ldflags: ["-Wl,-z,global"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "android.hardware.gnss@1.0-service.msm8960",
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "32",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.gnss@1.0-service.msm8960.rc"],
    srcs: ["service.cpp"],
    shared_libs: [
        // First, so that it is loaded before anything else that may need it.
        "libsched_policy_shim_msm8960",
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libhardware",
        "libbinder",
        "libhidlbase",
        "android.hardware.gnss@1.0",
    ],
}
