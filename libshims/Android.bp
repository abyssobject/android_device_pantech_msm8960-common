// The camera blobs link against a shared libskia.so, which Android no longer ships
// (libskia is a static library inside libhwui). Build one from the platform's static libskia.
cc_library_shared {
    name: "libskia_msm8960_shim",
    stem: "libskia",
    compile_multilib: "32",
    defaults: ["skia_deps"],
    whole_static_libs: ["libskia"],
    shared_libs: [
        "libEGL",
        "libGLESv2",
        "libcutils",
        "libharfbuzz_ng",
        "liblog",
        "libnativewindow",
        "libpng",
        "libvulkan",
        "libz",
    ],
    static_libs: [
        "libarect",
        "libperfetto_client_experimental",
    ],
}

// Android 16 always uses Treble linker namespaces (the legacy single-namespace
// ld.config that LineageOS 21 used with ro.treble.enabled=false is gone), so
// vendor executables and sphal HALs only see /vendor/lib plus LLNDK. The
// libraries below are vendor copies of system-only libraries that the legacy
// blobs under /system/vendor have in DT_NEEDED.

// libstdc++.so: needed by almost every blob (qseecomd, sensors.qcom,
// mm-qcamera-daemon, gps/nfc/sensors/camera HALs, libc2d2, libadsprpc, ...).
// bionic's libstdc++ has no vendor variant; this exports the same ABI.
cc_library_shared {
    name: "libstdc++_msm8960_vendor",
    stem: "libstdc++",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libstdcxx.cpp"],
    stl: "none",
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// libcamera_client.so: camera.msm8960.vendor.so (HAL1 blob, loaded in the
// sphal namespace) uses only android::CameraParameters from it, plus the
// Pantech CameraParameters extensions that LineageOS supplied through
// TARGET_LD_SHIM_LIBS (unsupported by AOSP bionic). CameraParameters.cpp is
// frameworks/av/camera/CameraParameters.cpp from android-16.0.0_r4, unchanged.
cc_library_shared {
    name: "libcamera_client_msm8960_vendor",
    stem: "libcamera_client",
    vendor: true,
    compile_multilib: "32",
    srcs: [
        "CameraParameters.cpp",
        "camera_parameters.cpp",
    ],
    include_dirs: [
        "frameworks/av/camera/include",
        "device/pantech/msm8960-common/include",
    ],
    header_libs: ["libsystem_headers"],
    shared_libs: [
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
    ],
}

// libskia.so, libicuuc.so, libicui18n.so: DT_NEEDED of libqc-opt.so, the
// mm-camera frame processing library (mm-qcamera-daemon: "dlopen failed:
// library libskia.so not found ... qcamsvr_start: mctl_load_comps failed").
// It imports two Skia and four ICU 56 symbols and nothing from libicui18n.
cc_library_shared {
    name: "libskia_msm8960_vendor",
    stem: "libskia",
    vendor: true,
    compile_multilib: "32",
    srcs: ["qc_opt_skia.cpp"],
    stl: "none",
}

cc_library_shared {
    name: "libicuuc_msm8960_vendor",
    stem: "libicuuc",
    vendor: true,
    compile_multilib: "32",
    srcs: ["qc_opt_icu.cpp"],
    stl: "none",
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_library_shared {
    name: "libicui18n_msm8960_vendor",
    stem: "libicui18n",
    vendor: true,
    compile_multilib: "32",
    srcs: ["empty.cpp"],
    stl: "none",
}

// libjnigraphics.so: DT_NEEDED of libOlaEngine.so (camera HAL dependency),
// which imports no symbols from it. libjnigraphics is a system NDK library.
cc_library_shared {
    name: "libjnigraphics_msm8960_vendor",
    stem: "libjnigraphics",
    vendor: true,
    compile_multilib: "32",
    srcs: ["empty.cpp"],
    stl: "none",
}
