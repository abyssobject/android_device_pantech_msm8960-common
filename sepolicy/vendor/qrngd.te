# Qualcomm PRNG daemon: feeds /dev/hw_random output into the kernel pool
# (RNDADDENTROPY needs CAP_SYS_ADMIN).
type qrngd, domain;
type qrngd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(qrngd)

allow qrngd hw_random_device:chr_file r_file_perms;
allow qrngd random_device:chr_file rw_file_perms;
allow qrngd self:global_capability_class_set sys_admin;
# It drops root after opening the devices.
allow qrngd self:global_capability_class_set { setuid setgid dac_override };
